{
  "name": "oh-my-coharness",
  "version": "0.1.10",
  "description": "Install once and let the AI coding CLIs you already use work together inside DeepSeek Harness. 装一次，让你装好的 AI 编程 CLI 在 DSH 里协同工作。",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "skills",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "coharness",
    "multi-harness",
    "codex",
    "claude-code",
    "gemini-cli",
    "kimi",
    "wsl",
    "orchestration"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node test/smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PengYangchao0808/oh-my-coharness.git"
  }
}
